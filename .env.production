# 系统编码
VITE_APP_SYSCODE = '/fnNew'

# 页面标题
VITE_APP_TITLE = 新财务系统

# 生产环境配置
VITE_APP_ENV = 'production'

# 生产环境   不需要配置前缀，nginx实现了代理
VITE_APP_BASE_API = '/api/fnNew'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip,brotli
VITE_APP_TIME='build time'

#本地调试基础服务配置地址
VITE_APP_BASIC_API = '/api/basic'
#office api地址
VITE_APP_DOCUMENTAPI = '/web-apps/apps/api/documents/api.js'
#图片文件配置回显地址
VITE_APP_FILE_URL = '/minioServer'
# 设置为 true 以排除 demo 目录
VITE_APP_EXCLUDE_DEMO = 'false'
