# 系统编码
VITE_APP_SYSCODE = '/fnNew'
# 页面标题
VITE_APP_TITLE = 新财务系统

# 生产环境配置
VITE_APP_ENV = 'development'

# SPD管理系统/本地环境
VITE_APP_BASE_API = '/api'
# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip
VITE_APP_TIME='build time'
# ureprot地址（本地调试链接地址）
VITE_APP_UREPORT_URL = 'http://172.16.11.183:9005/basic'
# 测试环境 office api地址
VITE_APP_DOCUMENTAPI = 'http://172.16.11.138:8990/web-apps/apps/api/documents/api.js'
# office api开发环境地址（文档editUrl地址，用于本地拼接地址）
VITE_APP_DOCUMENTBASEURL = 'http://172.16.11.138:9100/api'
#本地调试基础服务配置地址
VITE_APP_BASIC_API = '/api/basic'
#图片文件配置回显地址
VITE_APP_FILE_URL = 'http://172.16.11.232:9005/minioServer'
# 设置为 true 以排除 demo 目录
VITE_APP_EXCLUDE_DEMO = 'false'
